rules_version = '2';

// Security rules: who can read/write what. Deploy with
//   npx firebase-tools deploy --only firestore --project YOUR_PROJECT_ID
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function housePath(houseId) { return /databases/$(database)/documents/houses/$(houseId); }
    function memberPath(houseId, uid) { return /databases/$(database)/documents/houses/$(houseId)/members/$(uid); }
    function logPath(houseId, logId) { return /databases/$(database)/documents/houses/$(houseId)/logs/$(logId); }
    function isMember(houseId) { return signedIn() && exists(memberPath(houseId, me())); }
    function isAdmin(houseId) {
      let h = get(housePath(houseId)).data;
      return signedIn() && h.get('adminUid', h.createdBy) == me();
    }

    // ---- Private profile + demographics. Only the owner (and you, via the
    // admin export script) can read it. Housemates never see these.
    function validProfile(d) {
      return d.username is string && d.username.size() >= 2 && d.username.size() <= 24
        && d.dob is string && d.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        // at least 13 years old
        && timestamp.date(int(d.dob.split('-')[0]) + 13, int(d.dob.split('-')[1]), 1) <= request.time
        && d.gender in ['Male', 'Female', 'Non-binary', 'Other', 'Prefer not to say']
        && d.isStudent is bool
        && (d.university == null || (d.university is string && d.university.size() <= 100))
        && !('age' in d);
    }

    match /users/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && validProfile(request.resource.data)
        && request.resource.data.houseId == null;
      // houseId may only point at a house you are (or are becoming) a member
      // of, or be cleared (leaving / removed by the admin).
      allow update: if signedIn() && me() == uid
        && validProfile(request.resource.data)
        && (request.resource.data.houseId == null
            || request.resource.data.houseId == resource.data.houseId
            || existsAfter(memberPath(request.resource.data.houseId, uid)));
    }

    // ---- Code -> house lookup. You can look up one code, never list them all.
    match /houseCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && getAfter(housePath(request.resource.data.houseId)).data.code == code
        && getAfter(housePath(request.resource.data.houseId)).data.createdBy == me();
      allow update, delete: if false;
    }

    // ---- App owners (you). Add yourself in the Firebase console: a doc in
    // "owners" whose ID is your Account ID (shown at the bottom of Settings).
    // Owners can read feedback in the app's Feedback inbox.
    function isOwner() { return signedIn() && exists(/databases/$(database)/documents/owners/$(me())); }
    match /owners/{uid} {
      allow get: if signedIn() && uid == me();
      allow list, write: if false;
    }

    // ---- Feedback (bug reports + suggestions). Anyone signed in can send
    // one; only owners can read them (in the app's Feedback inbox, the
    // Firebase console, or scripts/export-feedback.mjs).
    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.userId == me()
        && request.resource.data.type in ['bug', 'suggestion']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000
        && (request.resource.data.screenshot == null
            || (request.resource.data.screenshot is string && request.resource.data.screenshot.size() < 900000))
        && !('done' in request.resource.data);
      allow read: if isOwner();
      // Owners can tick a report off as dealt with (and nothing else).
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && request.resource.data.done is bool;
      allow delete: if false;
    }

    match /houses/{houseId} {
      allow read: if isMember(houseId);
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && request.resource.data.adminUid == me()
        && getAfter(/databases/$(database)/documents/houseCodes/$(request.resource.data.code)).data.houseId == houseId;
      // Admin can rename, change chores, set when the leaderboard resets
      // (every 1/2/3/6 months, or 0 = custom dates), and hand admin to a
      // housemate.
      allow update: if isAdmin(houseId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'chores', 'adminUid', 'resetMonths', 'customStart', 'customEnd'])
        && validReset(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && (!('chores' in request.resource.data) || request.resource.data.chores.size() <= 60)
        && (request.resource.data.get('adminUid', resource.data.createdBy) == resource.data.get('adminUid', resource.data.createdBy)
            || exists(memberPath(houseId, request.resource.data.adminUid)));
      allow delete: if false;

      // ---- Members. stats.{period}.total / .chores.{key}: chores done in
      // each period (2 months unless the admin changed it).
      match /members/{uid} {
        allow read: if isMember(houseId);
        // Joining: must be yourself, start from zero, and know the real code.
        allow create: if signedIn() && me() == uid
          && getAfter(/databases/$(database)/documents/houseCodes/$(request.resource.data.joinCode)).data.houseId == houseId
          && request.resource.data.stats == {};
        // Your own doc: name, push token, and your score up by at most 1.
        allow update: if signedIn() && me() == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['username', 'pushToken', 'stats', 'lastCompletedAt', 'currentPeriod'])
          && ownStatsOk();
        // A housemate rejecting your chore takes exactly 1 off that chore.
        allow update: if isMember(houseId) && me() != uid && isRejectAdjustment(houseId, uid);
        // Leave yourself, or be removed by the admin.
        allow delete: if signedIn() && (me() == uid || isAdmin(houseId));
      }

      // A chore someone has done. Must come with a photo (photos/{logId}).
      match /logs/{logId} {
        allow read: if isMember(houseId);
        allow create: if isMember(houseId)
          && request.resource.data.userId == me()
          && request.resource.data.status == 'pending'
          && request.resource.data.reviewedBy == null
          && request.resource.data.period is string
          && request.resource.data.photoThumb is string
          && request.resource.data.photoThumb.size() < 100000
          && existsAfter(/databases/$(database)/documents/houses/$(houseId)/photos/$(logId));
        // One housemate (not the chore-doer) checks it, within 24 hours.
        // Rejecting must take it off the chore-doer's score in the same write.
        allow update: if isMember(houseId)
          && resource.data.userId != me()
          && resource.data.status == 'pending'
          && request.time < resource.data.at + duration.value(24, 'h')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'rejectReason'])
          && request.resource.data.reviewedBy == me()
          && request.resource.data.status in ['verified', 'rejected']
          && (request.resource.data.status == 'verified' || scoreDropped(houseId, resource.data))
          && (request.resource.data.get('rejectReason', null) == null
              || (request.resource.data.rejectReason is string && request.resource.data.rejectReason.size() <= 140));
        allow delete: if false;
      }

      // Full-size chore photos. Everyone in the house can see them.
      match /photos/{logId} {
        allow read: if isMember(houseId);
        allow create: if isMember(houseId)
          && request.resource.data.userId == me()
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
          && getAfter(logPath(houseId, logId)).data.userId == me();
        allow update, delete: if false;
      }

      // House wallpaper, set by the admin.
      match /wallpaper/{docId} {
        allow read: if isMember(houseId);
        allow create, update: if isAdmin(houseId)
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
        allow delete: if isAdmin(houseId);
      }

      match /requests/{requestId} {
        allow read: if isMember(houseId);
        // "Needs doing", or a checker sending a chore back to whoever did it.
        allow create: if isMember(houseId)
          && request.resource.data.requestedBy == me()
          && request.resource.data.assignedTo != me()
          && (request.resource.data.get('kind', 'needs') == 'needs'
              || (request.resource.data.kind == 'redo'
                  && getAfter(logPath(houseId, request.resource.data.logId)).data.userId == request.resource.data.assignedTo
                  && getAfter(logPath(houseId, request.resource.data.logId)).data.reviewedBy == me()
                  && getAfter(logPath(houseId, request.resource.data.logId)).data.status == 'rejected'))
          && exists(memberPath(houseId, request.resource.data.assignedTo))
          && request.resource.data.status == 'open';
        // Anyone in the house can close a request by doing it themselves.
        allow update: if isMember(houseId)
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'completedBy', 'completedAt'])
          && request.resource.data.status == 'done'
          && request.resource.data.completedBy == me();
        allow delete: if false;
      }
    }

    // resetMonths: 1, 2, 3 or 6, or 0 with customStart/customEnd dates.
    function validReset(h) {
      let m = h.get('resetMonths', 2);
      return m in [1, 2, 3, 6]
        || (m == 0
            && h.get('customStart', null) is string && h.customStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && h.get('customEnd', null) is string && h.customEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && h.customEnd > h.customStart);
    }

    // ---- Score rules ----

    // Your own score: only the period you name in currentPeriod changes,
    // its total goes up by 0 or 1, and you can only add to chore counts.
    function ownStatsOk() {
      let before = resource.data.get('stats', {});
      let after = request.resource.data.get('stats', {});
      let p = request.resource.data.get('currentPeriod', '');
      let changed = after.diff(before).affectedKeys();
      return changed.size() == 0
        || (changed.hasOnly([p])
            && after[p].total >= before.get([p, 'total'], 0)
            && after[p].total <= before.get([p, 'total'], 0) + 1);
    }

    // When a housemate rejects a chore, the chore-doer's score for that
    // period/chore must drop by exactly 1 (unless they've left the house).
    function scoreDropped(houseId, log) {
      let ownerPath = memberPath(houseId, log.userId);
      return !exists(ownerPath)
        || getAfter(ownerPath).data.get(['stats', log.period, 'total'], 0)
             == get(ownerPath).data.get(['stats', log.period, 'total'], 0) - 1;
    }

    function isRejectAdjustment(houseId, uid) {
      let logId = request.resource.data.lastReviewAdjust;
      let before = get(logPath(houseId, logId)).data;
      let after = getAfter(logPath(houseId, logId)).data;
      let p = after.period;
      let k = after.choreKey;
      let oldStats = resource.data.get('stats', {});
      let newStats = request.resource.data.stats;
      return after.userId == uid
        && before.status == 'pending' && after.status == 'rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'lastReviewAdjust'])
        && newStats.diff(oldStats).affectedKeys().hasOnly([p])
        && newStats[p].total == oldStats.get([p, 'total'], 0) - 1
        && newStats[p].get(['chores', k], 0) == oldStats.get([p, 'chores', k], 0) - 1;
    }
  }
}
