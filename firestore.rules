rules_version = '2';

// Security rules: who can read/write what. Deploy with
//   npx firebase-tools deploy --only firestore --project YOUR_PROJECT_ID
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function housePath(houseId) { return /databases/$(database)/documents/houses/$(houseId); }
    function memberPath(houseId, uid) { return /databases/$(database)/documents/houses/$(houseId)/members/$(uid); }
    function logPath(houseId, logId) { return /databases/$(database)/documents/houses/$(houseId)/logs/$(logId); }
    function offerPath(houseId, offerId) { return /databases/$(database)/documents/houses/$(houseId)/offers/$(offerId); }
    function isMember(houseId) { return signedIn() && exists(memberPath(houseId, me())); }
    function isAdmin(houseId) {
      let h = get(housePath(houseId)).data;
      return signedIn() && h.get('adminUid', h.createdBy) == me();
    }

    // ---- Private profile + demographics. Only the owner (and you, via the
    // admin export script) can read it. Housemates never see these.
    function validProfile(d) {
      return d.username is string && d.username.size() >= 2 && d.username.size() <= 24
        && d.dob is string && d.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        // at least 13 years old
        && timestamp.date(int(d.dob.split('-')[0]) + 13, int(d.dob.split('-')[1]), 1) <= request.time
        && d.gender in ['Male', 'Female', 'Non-binary', 'Other', 'Prefer not to say']
        && d.isStudent is bool
        // Students pick from the list (see lib/universities.ts). Older accounts
        // that typed something else keep it until they change it.
        && (d.university == null || d.university in universities()
            || (resource != null && d.university == resource.data.get('university', null)))
        && !('age' in d);
    }

    function universities() {
      return [
        // UNIVERSITIES-START
        "Abertay University",
        "Aberystwyth University",
        "Anglia Ruskin University",
        "Arden University",
        "Arts University Bournemouth",
        "Aston University",
        "Bangor University",
        "Bath Spa University",
        "Birkbeck, University of London",
        "Birmingham City University",
        "Bishop Grosseteste University",
        "Bournemouth University",
        "BPP University",
        "Brunel University London",
        "Buckinghamshire New University",
        "Canterbury Christ Church University",
        "Cardiff Metropolitan University",
        "Cardiff University",
        "City St George's, University of London",
        "Coventry University",
        "Cranfield University",
        "De Montfort University",
        "Durham University",
        "Edge Hill University",
        "Edinburgh Napier University",
        "Falmouth University",
        "Glasgow Caledonian University",
        "Goldsmiths, University of London",
        "Harper Adams University",
        "Hartpury University",
        "Heriot-Watt University",
        "Imperial College London",
        "Keele University",
        "King's College London",
        "Kingston University",
        "Lancaster University",
        "Leeds Arts University",
        "Leeds Beckett University",
        "Leeds Trinity University",
        "Liverpool Hope University",
        "Liverpool John Moores University",
        "London Metropolitan University",
        "London School of Economics and Political Science",
        "London South Bank University",
        "Loughborough University",
        "Manchester Metropolitan University",
        "Middlesex University",
        "Newcastle University",
        "Northeastern University London",
        "Northumbria University",
        "Norwich University of the Arts",
        "Nottingham Trent University",
        "Oxford Brookes University",
        "Plymouth Marjon University",
        "Queen Margaret University",
        "Queen Mary University of London",
        "Queen's University Belfast",
        "Ravensbourne University London",
        "Regent's University London",
        "Robert Gordon University",
        "Royal Agricultural University",
        "Royal College of Art",
        "Royal Holloway, University of London",
        "Royal Veterinary College",
        "Sheffield Hallam University",
        "SOAS University of London",
        "Solent University",
        "St Mary's University, Twickenham",
        "Staffordshire University",
        "Swansea University",
        "Teesside University",
        "The Open University",
        "Ulster University",
        "University College Birmingham",
        "University College London",
        "University for the Creative Arts",
        "University of Aberdeen",
        "University of Bath",
        "University of Bedfordshire",
        "University of Birmingham",
        "University of Bolton",
        "University of Bradford",
        "University of Brighton",
        "University of Bristol",
        "University of Buckingham",
        "University of Cambridge",
        "University of Central Lancashire",
        "University of Chester",
        "University of Chichester",
        "University of Cumbria",
        "University of Derby",
        "University of Dundee",
        "University of East Anglia",
        "University of East London",
        "University of Edinburgh",
        "University of Essex",
        "University of Exeter",
        "University of Glasgow",
        "University of Gloucestershire",
        "University of Greenwich",
        "University of Hertfordshire",
        "University of Huddersfield",
        "University of Hull",
        "University of Kent",
        "University of Law",
        "University of Leeds",
        "University of Leicester",
        "University of Lincoln",
        "University of Liverpool",
        "University of Manchester",
        "University of Northampton",
        "University of Nottingham",
        "University of Oxford",
        "University of Plymouth",
        "University of Portsmouth",
        "University of Reading",
        "University of Roehampton",
        "University of Salford",
        "University of Sheffield",
        "University of South Wales",
        "University of Southampton",
        "University of St Andrews",
        "University of Stirling",
        "University of Strathclyde",
        "University of Suffolk",
        "University of Sunderland",
        "University of Surrey",
        "University of Sussex",
        "University of the Arts London",
        "University of the Highlands and Islands",
        "University of the West of England",
        "University of the West of Scotland",
        "University of Wales Trinity Saint David",
        "University of Warwick",
        "University of West London",
        "University of Westminster",
        "University of Winchester",
        "University of Wolverhampton",
        "University of Worcester",
        "University of York",
        "Wrexham University",
        "York St John University",
        "Other UK university (not listed)",
        "University outside the UK"
        // UNIVERSITIES-END
      ];
    }

    match /users/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      // The app owner's dashboard (anonymous statistics).
      allow read: if isOwner();
      allow create: if signedIn() && me() == uid
        && validProfile(request.resource.data)
        && request.resource.data.houseId == null;
      // houseId may only point at a house you are (or are becoming) a member
      // of, or be cleared (leaving / removed by the admin).
      allow update: if signedIn() && me() == uid
        && validProfile(request.resource.data)
        && (request.resource.data.houseId == null
            || request.resource.data.houseId == resource.data.houseId
            || existsAfter(memberPath(request.resource.data.houseId, uid)));
    }

    // ---- Code -> house lookup. You can look up one code, never list them all.
    match /houseCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && getAfter(housePath(request.resource.data.houseId)).data.code == code
        && getAfter(housePath(request.resource.data.houseId)).data.createdBy == me();
      allow update, delete: if false;
    }

    // ---- Anonymous usage counts: one counter per event per day, +1 at a time.
    // Only the owner can read them (dashboard). Event names: lib/analytics.ts.
    match /analytics/{id} {
      allow read: if isOwner();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['day', 'event', 'n'])
        && request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.event in ['app_open', 'intro_start', 'intro_skip', 'intro_finish', 'signup', 'house_create', 'house_join', 'first_chore', 'chore_log', 'chore_flag', 'chore_verify', 'chore_sendback', 'offer_create', 'offer_counter', 'offer_accept', 'offer_paid', 'avatar_set', 'feedback_sent', 'tab_home', 'tab_checks', 'tab_leaderboard', 'tab_pay', 'tab_house', 'tab_settings']
        && id == request.resource.data.day + '_' + request.resource.data.event
        && request.resource.data.n == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    // ---- App owners (you). Add yourself in the Firebase console: a doc in
    // "owners" whose ID is your Account ID (shown at the bottom of Settings).
    // Owners can read feedback in the app's Feedback inbox.
    function isOwner() { return signedIn() && exists(/databases/$(database)/documents/owners/$(me())); }
    match /owners/{uid} {
      allow get: if signedIn() && uid == me();
      allow list, write: if false;
    }

    // ---- Feedback (bug reports + suggestions). Anyone signed in can send
    // one; only owners can read them (in the app's Feedback inbox, the
    // Firebase console, or scripts/export-feedback.mjs).
    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.userId == me()
        && request.resource.data.type in ['bug', 'suggestion']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000
        && (request.resource.data.screenshot == null
            || (request.resource.data.screenshot is string && request.resource.data.screenshot.size() < 900000))
        && !('done' in request.resource.data);
      allow read: if isOwner();
      // Owners can tick a report off as dealt with (and nothing else).
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && request.resource.data.done is bool;
      allow delete: if false;
    }

    // Owner dashboard: counts across all houses.
    match /{path=**}/members/{uid} { allow read: if isOwner(); }
    match /{path=**}/logs/{logId} { allow read: if isOwner(); }
    match /{path=**}/offers/{offerId} { allow read: if isOwner(); }

    match /houses/{houseId} {
      allow read: if isMember(houseId) || isOwner();
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && request.resource.data.adminUid == me()
        && validArea(request.resource.data.get('area', null))
        && getAfter(/databases/$(database)/documents/houseCodes/$(request.resource.data.code)).data.houseId == houseId;
      // Admin can rename, change chores, set when the leaderboard resets
      // (every 1/2/3/6 months, or 0 = custom dates), and hand admin to a
      // housemate.
      allow update: if isAdmin(houseId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'chores', 'adminUid', 'resetMonths', 'customStart', 'customEnd', 'area'])
        && validReset(request.resource.data)
        && validArea(request.resource.data.get('area', null))
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && (!('chores' in request.resource.data) || request.resource.data.chores.size() <= 60)
        && (request.resource.data.get('adminUid', resource.data.createdBy) == resource.data.get('adminUid', resource.data.createdBy)
            || exists(memberPath(houseId, request.resource.data.adminUid)));
      allow delete: if false;

      // ---- Members. stats.{period}.total / .chores.{key}: chores done in
      // each period (2 months unless the admin changed it).
      match /members/{uid} {
        allow read: if isMember(houseId);
        // Joining: must be yourself, start from zero, and know the real code.
        allow create: if signedIn() && me() == uid
          && getAfter(/databases/$(database)/documents/houseCodes/$(request.resource.data.joinCode)).data.houseId == houseId
          && request.resource.data.stats == {};
        // Your own doc: name, push token, profile picture, and your score up by at most 1.
        allow update: if signedIn() && me() == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['username', 'pushToken', 'stats', 'lastCompletedAt', 'currentPeriod', 'avatar', 'lastSeenAt'])
          && (!('lastSeenAt' in request.resource.data) || request.resource.data.lastSeenAt == request.time
              || request.resource.data.lastSeenAt == resource.data.get('lastSeenAt', null))
          && ownStatsOk()
          && validAvatar(request.resource.data.get('avatar', null));
        // A housemate rejecting your chore takes exactly 1 off that chore.
        allow update: if isMember(houseId) && me() != uid && isRejectAdjustment(houseId, uid);
        // Leave yourself, or be removed by the admin.
        allow delete: if signedIn() && (me() == uid || isAdmin(houseId));
      }

      // A chore someone has done. Must come with a photo (photos/{logId}).
      match /logs/{logId} {
        allow read: if isMember(houseId);
        allow create: if isMember(houseId)
          && request.resource.data.userId == me()
          && request.resource.data.status == 'pending'
          && request.resource.data.reviewedBy == null
          && request.resource.data.period is string
          && request.resource.data.photoThumb is string
          && request.resource.data.photoThumb.size() < 100000
          && existsAfter(/databases/$(database)/documents/houses/$(houseId)/photos/$(logId))
          && creditOk(houseId, logId, request.resource.data);
        // One housemate (not the chore-doer) checks it, within 24 hours.
        // Rejecting must take it off the chore-doer's score in the same write.
        allow update: if isMember(houseId)
          && resource.data.userId != me()
          && resource.data.status == 'pending'
          && request.time < resource.data.at + duration.value(24, 'h')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'rejectReason'])
          && request.resource.data.reviewedBy == me()
          && request.resource.data.status in ['verified', 'rejected']
          && (request.resource.data.status == 'verified'
              || resource.data.get('creditTo', null) != null
              || scoreDropped(houseId, resource.data))
          && (request.resource.data.get('rejectReason', null) == null
              || (request.resource.data.rejectReason is string && request.resource.data.rejectReason.size() <= 140));
        allow delete: if false;
      }

      // Full-size chore photos. Everyone in the house can see them.
      match /photos/{logId} {
        allow read: if isMember(houseId);
        allow create: if isMember(houseId)
          && request.resource.data.userId == me()
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
          && getAfter(logPath(houseId, logId)).data.userId == me();
        allow update, delete: if false;
      }

      // House wallpaper, set by the admin.
      match /wallpaper/{docId} {
        allow read: if isMember(houseId);
        allow create, update: if isAdmin(houseId)
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
        allow delete: if isAdmin(houseId);
      }

      // "I'll pay £3 for someone to do my chore." ID = the request's ID.
      // The app never holds money; people pay each other directly.
      match /offers/{offerId} {
        allow read: if isMember(houseId);
        allow create: if isMember(houseId)
          && request.resource.data.fromUid == me()
          && request.resource.data.requestId == offerId
          && get(/databases/$(database)/documents/houses/$(houseId)/requests/$(offerId)).data.assignedTo == me()
          && get(/databases/$(database)/documents/houses/$(houseId)/requests/$(offerId)).data.status == 'open'
          && get(/databases/$(database)/documents/houses/$(houseId)/requests/$(offerId)).data.get('kind', 'needs') == 'needs'
          && validPrice(request.resource.data.price)
          && request.resource.data.status == 'open'
          && request.resource.data.counters == {}
          && request.resource.data.declined == []
          && request.resource.data.doerUid == null
          && request.resource.data.get('doerPay', null) == null
          && request.resource.data.logId == null
          && request.resource.data.paid == false
          && request.resource.data.closed == false;
        allow update: if isMember(houseId) && offerUpdateOk(resource.data, request.resource.data, houseId, offerId);
        allow delete: if false;
      }

      match /requests/{requestId} {
        allow read: if isMember(houseId);
        // "Needs doing", or a checker sending a chore back to whoever did it.
        allow create: if isMember(houseId)
          && request.resource.data.requestedBy == me()
          && request.resource.data.assignedTo != me()
          && (request.resource.data.get('kind', 'needs') == 'needs'
              || (request.resource.data.kind == 'redo'
                  && getAfter(logPath(houseId, request.resource.data.logId)).data.userId == request.resource.data.assignedTo
                  && getAfter(logPath(houseId, request.resource.data.logId)).data.reviewedBy == me()
                  && getAfter(logPath(houseId, request.resource.data.logId)).data.status == 'rejected'))
          && exists(memberPath(houseId, request.resource.data.assignedTo))
          && request.resource.data.status == 'open';
        // Anyone in the house can close a request by doing it themselves.
        allow update: if isMember(houseId)
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'completedBy', 'completedAt'])
          && request.resource.data.status == 'done'
          && request.resource.data.completedBy == me();
        allow delete: if false;
      }
    }

    // Rough house location from the postcode: area only, never the full postcode.
    function validArea(a) {
      return a == null
        || (a is map && a.keys().hasOnly(['outcode', 'district', 'region', 'country'])
            && a.outcode is string && a.outcode.matches('^[A-Z]{1,2}[0-9][A-Z0-9]?$')
            && a.district is string && a.district.size() <= 60
            && a.region is string && a.region.size() <= 60
            && a.country is string && a.country.size() <= 30);
    }

    // resetMonths: 1, 2, 3 or 6, or 0 with customStart/customEnd dates.
    function validReset(h) {
      let m = h.get('resetMonths', 2);
      return m in [1, 2, 3, 6]
        || (m == 0
            && h.get('customStart', null) is string && h.customStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && h.get('customEnd', null) is string && h.customEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && h.customEnd > h.customStart);
    }

    // Profile picture: a small photo, or a drawn character (numbers pick each part).
    function validAvatar(a) {
      return a == null
        || (a is map && a.kind == 'photo' && a.keys().hasOnly(['kind', 'data']) && a.data is string && a.data.size() < 60000)
        || (a is map && a.kind == 'character'
            && a.keys().hasOnly(['kind', 'skin', 'hair', 'hairColor', 'eyes', 'mouth', 'extra', 'bg'])
            && part(a.skin, 6) && part(a.hair, 7) && part(a.hairColor, 6) && part(a.eyes, 4)
            && part(a.mouth, 4) && part(a.extra, 4) && part(a.bg, 6));
    }
    function part(v, n) { return v is int && v >= 0 && v < n; }

    // ---- Chore offers ----

    function validPrice(p) { return p is int && p >= 50 && p <= 5000; }

    // How the doer wants paying for one deal: a Monzo/PayPal link, or cash.
    function validPay(p) {
      return p is map && p.keys().hasOnly(['method', 'link'])
        && ((p.method == 'cash' && p.get('link', null) == null)
            || (p.method == 'monzo' && p.link is string && p.link.matches('^https://monzo[.]me/[A-Za-z0-9._-]{1,40}$'))
            || (p.method == 'paypal' && p.link is string && p.link.matches('^https://paypal[.]me/[A-Za-z0-9._-]{1,40}$')));
    }

    function offerUpdateOk(o, n, houseId, offerId) {
      let keys = n.diff(o).affectedKeys();
      let agreeKeys = ['status', 'doerUid', 'doerName', 'agreedPrice', 'agreedAt', 'doerPay'];
      return
        // A housemate accepts the asking price.
        (me() != o.fromUid && o.status == 'open' && keys.hasOnly(agreeKeys)
          && n.status == 'agreed' && n.doerUid == me() && n.agreedPrice == o.price && validPay(n.doerPay))
        // A housemate makes their one counter offer.
        || (me() != o.fromUid && o.status == 'open' && keys.hasOnly(['counters'])
          && n.counters.diff(o.counters).affectedKeys().hasOnly([me()])
          && !(me() in o.counters)
          && validPrice(n.counters[me()].price) && n.counters[me()].name is string
          && validPay(n.counters[me()].pay))
        // The offerer declines a counter offer.
        || (me() == o.fromUid && o.status == 'open' && keys.hasOnly(['declined'])
          && n.declined.hasAll(o.declined) && n.declined.size() == o.declined.size() + 1)
        // The offerer accepts a counter offer.
        || (me() == o.fromUid && o.status == 'open' && keys.hasOnly(agreeKeys)
          && n.status == 'agreed' && n.doerUid in o.counters && !(n.doerUid in o.declined)
          && n.agreedPrice == o.counters[n.doerUid].price
          && n.doerPay == o.counters[n.doerUid].get('pay', null))
        // The offerer withdraws it before anyone agrees.
        || (me() == o.fromUid && o.status == 'open' && keys.hasOnly(['status', 'closed'])
          && n.status == 'cancelled' && n.closed == true)
        // The doer logs the chore (or a redo of it) with a photo.
        || (me() == o.doerUid && o.status in ['agreed', 'done'] && keys.hasOnly(['status', 'logId'])
          && n.status == 'done'
          && getAfter(logPath(houseId, n.logId)).data.userId == me()
          && getAfter(logPath(houseId, n.logId)).data.offerId == offerId)
        // The doer nudges the offerer to pay, at most once a day.
        || (me() == o.doerUid && o.status == 'done' && keys.hasOnly(['remindedAt'])
          && n.remindedAt == request.time
          && (o.get('remindedAt', null) == null || request.time > o.remindedAt + duration.value(20, 'h')))
        // The offerer has paid.
        || (me() == o.fromUid && o.status == 'done' && keys.hasOnly(['paid', 'paidAt', 'closed'])
          && n.paid == true && n.closed == true);
    }

    // A chore logged for someone else must match an offer agreed with you.
    function creditOk(houseId, logId, log) {
      return log.get('creditTo', null) == null
        || (log.offerId is string
            && getAfter(offerPath(houseId, log.offerId)).data.doerUid == me()
            && getAfter(offerPath(houseId, log.offerId)).data.fromUid == log.creditTo
            && getAfter(offerPath(houseId, log.offerId)).data.logId == logId);
    }

    // ---- Score rules ----

    // Your own score: only the period you name in currentPeriod changes,
    // its total goes up by 0 or 1, and you can only add to chore counts.
    function ownStatsOk() {
      let before = resource.data.get('stats', {});
      let after = request.resource.data.get('stats', {});
      let p = request.resource.data.get('currentPeriod', '');
      let changed = after.diff(before).affectedKeys();
      return changed.size() == 0
        || (changed.hasOnly([p])
            && after[p].total >= before.get([p, 'total'], 0)
            && after[p].total <= before.get([p, 'total'], 0) + 1);
    }

    // When a housemate rejects a chore, the chore-doer's score for that
    // period/chore must drop by exactly 1 (unless they've left the house).
    function scoreDropped(houseId, log) {
      let ownerPath = memberPath(houseId, log.userId);
      return !exists(ownerPath)
        || getAfter(ownerPath).data.get(['stats', log.period, 'total'], 0)
             == get(ownerPath).data.get(['stats', log.period, 'total'], 0) - 1;
    }

    function isRejectAdjustment(houseId, uid) {
      let logId = request.resource.data.lastReviewAdjust;
      let before = get(logPath(houseId, logId)).data;
      let after = getAfter(logPath(houseId, logId)).data;
      let p = after.period;
      let k = after.choreKey;
      let oldStats = resource.data.get('stats', {});
      let newStats = request.resource.data.stats;
      return after.userId == uid
        && before.status == 'pending' && after.status == 'rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'lastReviewAdjust'])
        && newStats.diff(oldStats).affectedKeys().hasOnly([p])
        && newStats[p].total == oldStats.get([p, 'total'], 0) - 1
        && newStats[p].get(['chores', k], 0) == oldStats.get([p, 'chores', k], 0) - 1;
    }
  }
}
