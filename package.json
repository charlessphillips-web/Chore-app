  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test src/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:rules": "cd rules-tests && npm install && npm test",
    "lint": "expo lint",
    "deploy:web": "expo export --platform web && npx firebase-tools deploy --only hosting --project choreboard-58094",
    "deploy:server": "npm --prefix functions install && npx firebase-tools deploy --only functions,firestore --project choreboard-58094",
    "update:app": "npx eas-cli@latest update --channel production --environment production --message \"Rotawise update\""
  },
  "private": true
