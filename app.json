{
  "expo": {
    "name": "Rotawise",
    "slug": "choreboard",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rotawise.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4C1D95",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.charlesphillips.choreboard"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Rotawise",
      "shortName": "Rotawise",
      "backgroundColor": "#000000",
      "themeColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rotawise uses your camera so you can photograph chores you have done for your housemates to check.",
          "photosPermission": "Rotawise uses your photos for your profile picture, the house wallpaper and bug report screenshots."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Rotawise can notice when your phone is away from home overnight and ask if you want to pause your chores. Your location stays on your phone and is never shared.",
          "locationWhenInUsePermission": "Rotawise uses your location once, while you are at home, to remember where home is. It stays on your phone.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 84,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "scheme": "choreboard",
    "backgroundColor": "#000000",
    "owner": "choreboard",
    "extra": {
      "eas": {
        "projectId": "c4acb62e-73e6-4d2d-8523-6d8bac597f57"
      }
    }
  }
}
