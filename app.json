{
  "expo": {
    "name": "Rotawise",
    "slug": "choreboard",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.charlesphillips.choreboard",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4C1D95",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.charlesphillips.choreboard"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Rotawise",
      "shortName": "Rotawise",
      "backgroundColor": "#000000",
      "themeColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rotawise uses your camera so you can photograph chores you have done for your housemates to check.",
          "photosPermission": "Rotawise uses your photos for your profile picture, the house wallpaper and bug report screenshots."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "scheme": "choreboard",
    "backgroundColor": "#000000",
    "owner": "choreboard",
    "extra": {
      "eas": {
        "projectId": "c4acb62e-73e6-4d2d-8523-6d8bac597f57"
      }
    }
  }
}
