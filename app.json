{
  "expo": {
    "name": "Choreboard",
    "slug": "choreboard",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.charlesphillips.choreboard",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4C1D95",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.charlesphillips.choreboard"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Choreboard uses your camera so you can photograph chores you have done for your housemates to check.",
          "photosPermission": "Choreboard uses your photos so a house admin can choose a wallpaper for the house."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "choreboard",
    "backgroundColor": "#000000"
  }
}
